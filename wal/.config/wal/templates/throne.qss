/*
 * Throne Dark Pywal Dynamic Theme
 * Auto-generated by Pywal from system wallpaper / palette
 */

QPalette {{ background: {background}; }}
* {{
    outline: 0px;
    color: {foreground};
}}

QWidget {{
    font-family: inherit;
}}

/* Main Window & Dialogs */
QMainWindow, QDialog, QWidget[form="true"] {{
    background-color: {background};
    color: {foreground};
}}

/* Graphics & Views */
QGraphicsView {{
    border: 1px solid {color8};
    background-color: {background};
    qproperty-backgroundBrush: {background};
}}

QWidget[form="true"], QLabel[frameShape="1"] {{
    border: 1px solid {color8};
    border-radius: 4px;
}}

/* Header and Panels */
QWidget[form="bottom"] {{
    background-color: {color0.lighten(8)};
}}

QWidget[form="bottom"] .QFrame {{
    border: 1px solid {color8};
}}

QWidget[form="bottom"] QLabel, QWidget[form="title"] QLabel {{
    border-radius: 0px;
    color: {foreground};
    background: transparent;
    border-style: none;
}}

QWidget[form="title"], QWidget[nav="left"], QWidget[nav="top"] QAbstractButton {{
    border-style: none;
    border-radius: 4px;
    padding: 6px;
    color: {foreground};
    background: {color0.lighten(6)};
}}

QWidget[nav="top"] QAbstractButton:hover, QWidget[nav="top"] QAbstractButton:pressed, QWidget[nav="top"] QAbstractButton:checked {{
    border-style: solid;
    border-width: 0px 0px 2px 0px;
    padding: 5px 5px 3px 5px;
    border-color: {color4};
    background: {color0.lighten(14)};
}}

QWidget[nav="left"] QAbstractButton {{
    border-radius: 4px;
    color: {foreground};
    background: transparent;
    border-style: none;
}}

QWidget[nav="left"] QAbstractButton:hover {{
    color: #ffffff;
    background-color: {color4};
}}

QWidget[nav="left"] QAbstractButton:checked, QWidget[nav="left"] QAbstractButton:pressed {{
    color: {foreground};
    border-style: solid;
    border-width: 0px 0px 0px 3px;
    padding: 4px 4px 4px 3px;
    border-color: {color4};
    background-color: {color0.lighten(10)};
}}

/* Inputs & Edits */
QLineEdit:read-only {{
    background-color: {color0.lighten(6)};
}}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit, QDateTimeEdit {{
    border: 1px solid {color8};
    border-radius: 4px;
    padding: 4px;
    background-color: {color0.lighten(4)};
    selection-background-color: {color4};
    selection-color: {background};
}}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {{
    border: 1px solid {color4};
    background-color: {color0.lighten(6)};
}}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover, QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover {{
    border: 1px solid {color4};
}}

.QFrame {{
    border: 1px solid {color8};
    border-radius: 4px;
}}

.QGroupBox {{
    border: 1px solid {color8};
    border-radius: 6px;
    margin-top: 2.5ex;
    padding-top: 6px;
    background-color: {color0.lighten(2)};
}}

.QGroupBox::title {{
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: {color4};
    font-weight: 600;
}}

/* Buttons */
.QPushButton, .QToolButton, StartStopButton {{
    border: 1px solid {color8};
    color: {foreground};
    padding: 5px 12px;
    min-height: 18px;
    border-radius: 5px;
    background-color: {color0.lighten(10)};
}}

.QPushButton:hover, .QToolButton:hover, StartStopButton:hover {{
    border-color: {color4};
    background-color: {color0.lighten(18)};
}}

.QPushButton:pressed, .QToolButton:pressed, StartStopButton:pressed {{
    border-color: {color4};
    background-color: {color0.lighten(8)};
}}

.QPushButton:disabled, .QToolButton:disabled, StartStopButton:disabled {{
    background-color: {color0.lighten(4)};
    border-color: {color0.lighten(8)};
    color: {color8};
}}

.QToolButton::menu-indicator {{
    image: None;
}}

/* Tab corner widgets (like filter button) */
QTabWidget QToolButton {{
    border: 1px solid {color8};
    border-radius: 4px;
    background-color: {color0.lighten(8)};
    padding: 3px 6px;
    margin: 2px;
}}

QTabWidget QToolButton:hover {{
    border-color: {color4};
    background-color: {color0.lighten(16)};
}}

QTabWidget QToolButton:checked {{
    border: 1px solid {color4};
    background-color: {color4};
    color: {background};
}}

/* Top navigation action buttons */
QToolButton#toolButton_program,
QToolButton#toolButton_preferences,
QToolButton#toolButton_testing,
QToolButton#toolButton_routing,
QToolButton#toolButton_tools {{
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    background: transparent;
    color: {foreground};
}}

QToolButton#toolButton_program:hover,
QToolButton#toolButton_preferences:hover,
QToolButton#toolButton_testing:hover,
QToolButton#toolButton_routing:hover,
QToolButton#toolButton_tools:hover {{
    border: 1px solid {color8};
    background-color: {color0.lighten(12)};
}}

QToolButton#toolButton_program:pressed,
QToolButton#toolButton_preferences:pressed,
QToolButton#toolButton_testing:pressed,
QToolButton#toolButton_routing:pressed,
QToolButton#toolButton_tools:pressed {{
    border: 1px solid {color4};
    background-color: {color0.lighten(6)};
}}

/* Radio Buttons & Checkboxes */
QRadioButton::indicator {{
    width: 15px;
    height: 15px;
}}

QRadioButton::indicator::unchecked {{
    image: url(:/qss/blacksoft/radiobutton_unchecked.png);
}}

QRadioButton::indicator::unchecked:disabled {{
    image: url(:/qss/blacksoft/radiobutton_unchecked_disable.png);
}}

QRadioButton::indicator::checked {{
    image: url(:/qss/blacksoft/radiobutton_checked.png);
}}

QRadioButton::indicator::checked:disabled {{
    image: url(:/qss/blacksoft/radiobutton_checked_disable.png);
}}

QCheckBox::indicator {{
    width: 14px;
    height: 14px;
}}

QCheckBox::indicator:unchecked {{
    image: url(:/qss/blacksoft/checkbox_unchecked.png);
}}

QCheckBox::indicator:unchecked:disabled {{
    image: url(:/qss/blacksoft/checkbox_unchecked_disable.png);
}}

QCheckBox::indicator:checked {{
    image: url(:/qss/blacksoft/checkbox_checked.png);
}}

QCheckBox::indicator:checked:disabled {{
    image: url(:/qss/blacksoft/checkbox_checked_disable.png);
}}

QCheckBox::indicator:indeterminate {{
    image: url(:/qss/blacksoft/checkbox_parcial.png);
}}

QCheckBox::indicator:indeterminate:disabled {{
    image: url(:/qss/blacksoft/checkbox_parcial_disable.png);
}}

/* Spinboxes & Combos */
QTimeEdit::up-button, QDateEdit::up-button, QDateTimeEdit::up-button, QDoubleSpinBox::up-button, QSpinBox::up-button {{
    image: url(:/qss/blacksoft/add_top.png);
    width: 10px;
    height: 10px;
    padding: 2px 5px 0px 0px;
}}

QTimeEdit::down-button, QDateEdit::down-button, QDateTimeEdit::down-button, QDoubleSpinBox::down-button, QSpinBox::down-button {{
    image: url(:/qss/blacksoft/add_bottom.png);
    width: 10px;
    height: 10px;
    padding: 0px 5px 2px 0px;
}}

QComboBox::down-arrow, QDateEdit[calendarPopup="true"]::down-arrow, QTimeEdit[calendarPopup="true"]::down-arrow, QDateTimeEdit[calendarPopup="true"]::down-arrow {{
    image: url(:/qss/blacksoft/add_bottom.png);
    width: 10px;
    height: 10px;
    right: 4px;
}}

QComboBox::drop-down, QDateEdit::drop-down, QTimeEdit::drop-down, QDateTimeEdit::drop-down {{
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid {color8};
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}}

/* Menus & MenuBar */
QMenuBar {{
    background-color: {color0.lighten(6)};
    border-bottom: 1px solid {color8};
    color: {foreground};
}}

QMenuBar::item {{
    color: {foreground};
    background-color: transparent;
    padding: 4px 10px;
}}

QMenuBar::item:selected {{
    background-color: {color0.lighten(14)};
    color: {foreground};
    border-radius: 3px;
}}

QMenu {{
    color: {foreground};
    background-color: {color0.lighten(6)};
    border: 1px solid {color8};
    border-radius: 6px;
    padding: 4px;
}}

QMenu::item {{
    padding: 5px 24px 5px 20px;
    border-radius: 4px;
}}

QMenu::item:selected {{
    color: #ffffff;
    background-color: {color4};
}}

QMenu::separator {{
    height: 1px;
    background-color: {color8};
    margin: 4px 6px;
}}

QMenu::indicator {{
    width: 16px;
    height: 14px;
}}

QMenu::indicator::checked {{
    image: url(:/qss/blacksoft/menu_checked.png);
}}

QMenu::right-arrow {{
    image: url(:/qss/blacksoft/arrow_right.png);
    width: 12px;
    height: 12px;
    padding-right: 4px;
}}

/* Progress & Sliders */
QProgressBar {{
    min-height: 12px;
    background-color: {color0.lighten(6)};
    border-radius: 6px;
    text-align: center;
    border: 1px solid {color8};
    color: {foreground};
}}

QProgressBar:chunk {{
    border-radius: 5px;
    background-color: {color4};
}}

QSlider::groove:horizontal {{
    height: 6px;
    border-radius: 3px;
    background: {color0.lighten(10)};
}}

QSlider::sub-page:horizontal {{
    height: 6px;
    border-radius: 3px;
    background: {color4};
}}

QSlider::handle:horizontal {{
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
    background: {color4};
    border: 1px solid {foreground};
}}

/* Scrollbars */
QScrollBar:horizontal {{
    background: {background};
    padding: 0px;
    border-radius: 4px;
    max-height: 10px;
}}

QScrollBar::handle:horizontal {{
    background: {color8};
    min-width: 40px;
    border-radius: 4px;
}}

QScrollBar::handle:horizontal:hover {{
    background: {color4};
}}

QScrollBar:vertical {{
    background: {background};
    padding: 0px;
    border-radius: 4px;
    max-width: 10px;
}}

QScrollBar::handle:vertical {{
    background: {color8};
    min-height: 40px;
    border-radius: 4px;
}}

QScrollBar::handle:vertical:hover {{
    background: {color4};
}}

QScrollBar::add-page, QScrollBar::sub-page, QScrollBar::add-line, QScrollBar::sub-line {{
    background: none;
    border: none;
}}

/* Tables, Trees & Lists */
QTreeView, QListView, QTableView, QTabWidget::pane {{
    border: 1px solid {color8};
    background-color: {background};
    selection-background-color: {color0.lighten(16)};
    selection-color: {foreground};
    alternate-background-color: {color0.lighten(4)};
    gridline-color: {color0.lighten(8)};
}}

QTreeView::branch:closed:has-children {{
    margin: 4px;
    border-image: url(:/qss/blacksoft/branch_open.png);
}}

QTreeView::branch:open:has-children {{
    margin: 4px;
    border-image: url(:/qss/blacksoft/branch_close.png);
}}

QTableView::item:selected, QListView::item:selected, QTreeView::item:selected {{
    color: #ffffff;
    background-color: {color0.lighten(20)};
    border-left: 3px solid {color4};
}}

QTableView::item:hover, QListView::item:hover, QTreeView::item:hover {{
    background-color: {color0.lighten(10)};
}}

QHeaderView, QHeaderView::section, QTableCornerButton:section {{
    color: {foreground};
    background-color: {color0.lighten(8)};
    padding: 6px;
    border: 1px solid {color8};
    border-left-width: 0px;
    border-top-width: 0px;
    font-weight: 600;
}}

/* Splitters */
QSplitter::handle {{
    background-color: {color0.lighten(6)};
    height: 4px;
    width: 4px;
}}

QSplitter::handle:hover {{
    background-color: {color4};
}}

/* Tabs */
QTabBar::tab {{
    border: 1px solid {color8};
    border-bottom: none;
    color: {foreground};
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    background-color: {color0.lighten(8)};
}}

QTabBar::tab:selected {{
    color: {color4};
    font-weight: bold;
    border-bottom: 2px solid {color4};
    background-color: {background};
}}

QTabBar::tab:hover:!selected {{
    background-color: {color0.lighten(14)};
}}

/* Tooltips */
QToolTip {{
    border: 1px solid {color4};
    border-radius: 4px;
    background-color: {color0.lighten(8)};
    color: {foreground};
    padding: 4px 8px;
}}

/* Statusbar */
QStatusBar {{
    background-color: {color0.lighten(4)};
    border-top: 1px solid {color8};
    color: {foreground};
}}

QStatusBar QLabel {{
    color: {foreground};
}}

/* Disabled States */
*:disabled, QMenu::item:disabled, QTabBar:tab:disabled, QHeaderView::section:disabled {{
    background-color: {color0.lighten(2)};
    border-color: {color0.lighten(6)};
    color: {color8};
}}
