# === 1. Переменные и Цвета ===
set $mod Mod4
set $term kitty

# Подгружаем цвета Pywal
exec_always --no-startup-id xrdb ~/.cache/wal/colors.Xresources
include ~/.cache/wal/colors-waybar

# Дефолтные цвета (на случай, если wal не сработал)
set_from_resource $bg i3wm.color0 #000000
set_from_resource $fg i3wm.color15 #ffffff
set_from_resource $col_focused i3wm.color4 #000000

# === 2. Настройка Дисплеев и Графики ===
# Фикс V-Sync: заставляем NVIDIA синхронизироваться по HDMI-0 (75Hz)
exec_always --no-startup-id env __GL_SYNC_DISPLAY_DEVICE=HDMI-0 xrandr --output HDMI-0 --mode 1920x1080 --rate 74.97 --primary --pos 0x0 --output DVI-D-0 --mode 1360x768 --pos 1920x250

# === 3. Внешний Вид (Gaps & Borders) ===
font pango:JetBrainsMono Nerd Font Bold 11

gaps inner 12
gaps outer 5
smart_gaps off
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Цвета рамок (class, border, backgr, text, indicator, child_border)
client.focused          $col_focused $col_focused $fg     $col_focused $col_focused
client.focused_inactive #333333      #333333      #888888 #333333      #333333
client.unfocused        #222222      #222222      #888888 #222222      #222222

# === 4. Управление Окнами (Keybindings) ===
floating_modifier $mod
bindsym $mod+Shift+f floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+q kill

# Фокус (стрелки)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Перемещение окон (стрелки)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# === 5. Воркспейсы ===
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

# Скролл между столами
bindsym --whole-window $mod+button4 workspace prev_on_output
bindsym --whole-window $mod+button5 workspace next_on_output

# === 6. Запуск Приложений ===
bindsym $mod+Return exec $term
bindsym $mod+d exec rofi -normal-window -show drun
bindsym $mod+b exec zen-browser
bindsym $mod+c exec rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}'
bindsym $mod+Shift+s exec code ~/.config/i3/config
bindsym $mod+t exec "~/.config/i3/scripts/wallpaper.sh"

# Системные бинды
bindsym $mod+Shift+c restart
bindsym $mod+n exec dunstctl history-pop

# === 7. Мультимедиа (Звук и Яркость) ===
bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute        exec pamixer -t
bindsym XF86AudioMicMute     exec pamixer --default-source -t

bindsym XF86MonBrightnessUp   exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# === 8. Скриншоты (Maim) ===
# Скриншоты через скрипт
bindsym Print       exec --no-startup-id ~/.config/i3/scripts/screenshot.sh active
bindsym Shift+Print exec --no-startup-id ~/.config/i3/scripts/screenshot.sh area

# === 9. Правила Окон (for_window) ===
# Плавающие окна
for_window [class="Rofi"] floating enable, border pixel 0
for_window [class="Polkit-kde-authentication-agent-1"] floating enable

# Софт без рамок
for_window [class="discord"] border none

# === 10. Автозапуск ===
exec_always --no-startup-id sh -c "sleep 2 && setxkbmap -layout us,ru -option grp:win_space_toggle"
exec --no-startup-id /usr/lib/polkit-kde-authentication-agent-1
exec --no-startup-id greenclip daemon

exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id ~/.fehbg
exec_always --no-startup-id dunst
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id autotiling
